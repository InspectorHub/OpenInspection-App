{
  "name": "openinspection-app",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Offline-first InspectorHub field client for Android, iOS and Windows",
  "author": "InspectorHub",
  "homepage": "https://github.com/InspectorHub/OpenInspection-App",
  "license": "AGPL-3.0-only",
  "main": "dist-electron/main/index.cjs",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:dev": "tsc --noEmit && node -e \"process.env.NODE_ENV='development';import('vite').then(v=>v.build({mode:'development'}))\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p electron",
    "build:electron": "node scripts/build-electron.mjs && npm run build:electron:renderer",
    "build:heic-helper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-heic-helper.ps1",
    "build:electron:renderer": "vite build -c vite.electron.config.ts",
    "dev:electron": "node scripts/dev-electron.mjs",
    "check:electron-bundle": "node scripts/check-electron-bundle.mjs",
    "test:e2e:electron": "playwright test -c e2e-electron/playwright.config.ts",
    "check:bundle": "node scripts/check-release-bundle.mjs",
    "test": "vitest run",
    "cap:sync": "cap sync",
    "api:types": "node scripts/api-types.mjs",
    "api:types:check": "node scripts/api-types.mjs --check",
    "contract:fixture": "node scripts/sync-contract-fixture.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-uploader": "^8.3.23",
    "@inspectorhub/field-ui": "~0.5.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "fflate": "^0.8.3",
    "konva": "10.9.0",
    "lib0": "^0.2.119",
    "oauth4webapi": "^3.8.8",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "6.2.4",
    "react-konva": "19.3.2",
    "react-photo-album": "3.6.2",
    "sortablejs": "1.15.7",
    "y-protocols": "^1.0.7",
    "yet-another-react-lightbox": "3.32.2",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "sql.js": "^1.14.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}

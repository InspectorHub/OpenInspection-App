  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:dev": "tsc --noEmit && node -e \"process.env.NODE_ENV='development';import('vite').then(v=>v.build({mode:'development'}))\"",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node scripts/check-release-bundle.mjs",
    "test": "vitest run",
    "cap:sync": "cap sync",
    "api:types": "node scripts/api-types.mjs",
    "api:types:check": "node scripts/api-types.mjs --check",
    "contract:fixture": "node scripts/sync-contract-fixture.mjs"
  },
  "dependencies": {
